# Copy this file to .env.local for local development (vercel dev).
# In production, set these as Environment Variables in the Vercel project dashboard instead.
# Never commit real keys — .env.local is already gitignored.

# Used only by api/send-welcome-email.js to verify Stripe's webhook signature —
# the site no longer creates Checkout Sessions of its own, checkout goes
# straight to a Stripe Payment Link instead.
STRIPE_SECRET_KEY=sk_test_...

# Your real WhatsApp Business number in international format, digits only,
# no "+" (e.g. 31612345678). Used to build wa.me links on the site.
# This one is frontend-visible, not secret — Vite only exposes VITE_-prefixed vars.
VITE_WHATSAPP_NUMBER=31612345678

# Resend — sends the contact form's email to lisanaiservice@outlook.com, and
# the post-purchase welcome email to the customer.
# Sign up free at resend.com, API key from the dashboard.
RESEND_API_KEY=re_...

# Signing secret for the Stripe webhook that triggers the welcome email
# (api/send-welcome-email.js). Register the Payment Link's mode + this site's
# URL ("checkout.session.completed" only) as a destination in Stripe Dashboard
# → Developers → Webhooks, then copy the signing secret it gives you here.
STRIPE_WEBHOOK_SECRET=whsec_...
